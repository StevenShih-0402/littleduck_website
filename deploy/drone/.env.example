# deploy/drone/.env.example
# Drone server／runner 的環境變數範本：在主機上複製成 /opt/drone/.env 後填值，.env 不進版控

# GitHub OAuth App（Settings → Developer settings → OAuth Apps）
# Homepage URL：https://<DRONE_SERVER_HOST>　Callback URL：https://<DRONE_SERVER_HOST>/login
DRONE_GITHUB_CLIENT_ID=
DRONE_GITHUB_CLIENT_SECRET=

# server 與 runner 共用的 RPC 密鑰，以 `openssl rand -hex 16` 產生
DRONE_RPC_SECRET=

# 對外網址（不含 https://），例：drone.example.com
DRONE_SERVER_HOST=

# 允許登入的 GitHub 帳號（逗號分隔），其他帳號一律拒絕
DRONE_USER_FILTER=StevenShih-0402

# 第一次啟動時建立的管理員（可設定 repo 的 Trusted 與 secret）
DRONE_USER_CREATE=username:StevenShih-0402,admin:true
