# deploy/edge/woodpecker.conf.template
# Woodpecker server 的 Nginx 站台：以 render.sh 只帶入 ${WOODPECKER_SITE_HOST} 後放到主機 /opt/edge-sites/，由 mygo 的 Nginx include

server {
    listen 80;
    server_name ${WOODPECKER_SITE_HOST};

    # certbot webroot 驗證路徑（與 mygo 共用 /var/www/certbot）
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${WOODPECKER_SITE_HOST};

    ssl_certificate     /etc/letsencrypt/live/${WOODPECKER_SITE_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${WOODPECKER_SITE_HOST}/privkey.pem;

    # 以變數＋resolver 延後解析，Woodpecker 容器重建換 IP 或尚未啟動時 Nginx 仍能啟動（同 mygo 的作法）
    resolver 127.0.0.11 valid=10s;
    set $woodpecker_upstream littleduck-woodpecker-server:8000;

    location / {
        proxy_pass http://$woodpecker_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 建置記錄以 SSE 長連線串流
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
