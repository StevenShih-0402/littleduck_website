# deploy/woodpecker/.env.example
# Woodpecker server／agent 的環境變數範本：在主機上複製成 /opt/woodpecker/.env（權限 600）後填值，.env 不進版控

# 對外網址（含 https://），GitHub OAuth 的 callback 與 webhook 位址都由它組成
WOODPECKER_HOST=https://ci.stevenshih-littleduck.com

# GitHub forge：用 OAuth App，不要用 GitHub App（官方文件說明目前不能正常運作）
# Settings → Developer settings → OAuth Apps
# Homepage URL：https://ci.stevenshih-littleduck.com　Authorization callback URL：https://ci.stevenshih-littleduck.com/authorize
WOODPECKER_GITHUB=true
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=

# server 與 agent 共用的密鑰，以 `openssl rand -hex 32` 產生；compose 也從本檔讀它傳給 agent
WOODPECKER_AGENT_SECRET=

# 關閉自由註冊：只有 WOODPECKER_ADMIN 列出的帳號能第一次登入（建立帳號）
WOODPECKER_OPEN=false

# 管理員（可設定 repo 的 Trusted、secret 與核准），逗號分隔
WOODPECKER_ADMIN=StevenShih-0402

# 只有這些帳號（或組織）擁有的 repo 可以在 Woodpecker 啟用，逗號分隔
WOODPECKER_REPO_OWNERS=StevenShih-0402
