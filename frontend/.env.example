# frontend/.env.example
# 後端 API 位址有兩種設定，優先序：API_BASE_URL（執行期）> NEXT_PUBLIC_API_BASE_URL（建置期）> http://localhost:8080

# 執行期（優先）：容器啟動時由伺服器讀取，經 /runtime-config.js 注入瀏覽器；
# 同一份映像可在 Staging 與 Production 使用不同位址。部署主機的 .env 只放這個。
API_BASE_URL=http://localhost:8080

# 建置期（本機開發後備）：需 NEXT_PUBLIC_ 前綴才會內嵌到 client bundle；映像建置不帶此值。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
