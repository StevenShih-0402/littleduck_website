# backend/.env.example
# 環境變數範本：複製為 .env 並填入實際值（.env 不進版控）

# ── 伺服器 ──────────────────────────────────────
# HTTP 監聽埠（選填，預設 8080）
PORT=8080
# Gin 模式：debug / release / test（選填，預設 debug；正式環境請用 release）
GIN_MODE=debug

# ── 資料庫（PostgreSQL）─────────────────────────
# 資料庫主機（必要）
DB_HOST=localhost
# 資料庫埠（選填，預設 5432）
DB_PORT=5432
# 資料庫使用者（必要）
DB_USER=littleduck
# 資料庫密碼（必要）
DB_PASSWORD=changeme
# 資料庫名稱（必要）
DB_NAME=littleduck
# SSL 模式：disable / require / verify-full（選填，預設 disable）
DB_SSLMODE=disable

# ── 日誌 ────────────────────────────────────────
# 日誌等級：debug / info / warn / error（選填，預設 info）
LOG_LEVEL=info

# ── 綠界金流（ECPay）────────────────────────────
# 商店代號（骨架階段選填；正式串接時必要）
ECPAY_MERCHANT_ID=
# HashKey（骨架階段選填；正式串接時必要）
ECPAY_HASH_KEY=
# HashIV（骨架階段選填；正式串接時必要）
ECPAY_HASH_IV=
# 綠界環境：stage / production（選填，預設 stage）
ECPAY_ENV=stage
